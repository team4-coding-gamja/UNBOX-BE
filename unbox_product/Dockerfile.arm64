# ============================================
# Multi-stage build for Spring Boot Application (ARM64 호환)
# ============================================

# Stage 1: Build
FROM --platform=linux/amd64 eclipse-temurin:17 AS builder

# Gradle 설치
RUN apt-get update && apt-get install -y wget unzip && \
    wget https://services.gradle.org/distributions/gradle-8.5-bin.zip && \
    unzip gradle-8.5-bin.zip && \
    mv gradle-8.5 /opt/gradle && \
    ln -s /opt/gradle/bin/gradle /usr/bin/gradle

WORKDIR /app

# 변경 빈도가 낮은 파일부터 복사 (캐시 최적화)
COPY settings.gradle ./settings.gradle
COPY unbox_product/build.gradle ./build.gradle

# 공통 모듈 복사
COPY unbox_common ./unbox_common

# 의존성 다운로드 (캐시 레이어)
RUN gradle dependencies --no-daemon || true

# 소스 코드 복사 (가장 자주 변경됨)
COPY unbox_product/src ./src

# 빌드
RUN gradle bootJar --no-daemon -x test

# Stage 2: Runtime
FROM --platform=linux/amd64 eclipse-temurin:17-jre-alpine

WORKDIR /app

# 비root 사용자 생성
RUN addgroup -S spring && adduser -S spring -G spring

# Create logs directory and set ownership
RUN mkdir -p logs && chown -R spring:spring logs && chown -R spring:spring /app

# wget 설치 (health check용)
RUN apk add --no-cache wget

USER spring:spring

# JAR 파일 복사
COPY --from=builder /app/build/libs/*.jar app.jar

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${SERVER_PORT:-8082}/actuator/health || exit 1

EXPOSE 8082

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]